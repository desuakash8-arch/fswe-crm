# Set these in your shell; Spring Boot does not automatically load .env files.
DB_URL=jdbc:mysql://localhost:3306/crm_db
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password
SERVER_PORT=8085
DB_DDL_AUTO=validate
# At least 32 bytes; use a private random secret for deployment.
JWT_SECRET=replace_with_a_private_random_secret_at_least_32_bytes
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
# Render free uses MAIL_PROVIDER=resend and an HTTPS API key instead of SMTP.
RESEND_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email_address
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email_address
# Optional local test inbox; leave blank for delivery to assigned employees.
MAIL_RECIPIENT_OVERRIDE=

PUBLIC_APP_URL=http://127.0.0.1:5173
BACKGROUND_JOBS_ENABLED=true
# Razorpay demonstration checkout (test keys only; set in backend environment or application-local.properties).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: a separate secret chosen for your Razorpay test webhook.
RAZORPAY_WEBHOOK_SECRET=

# Cloud setup: use prod,cloud and the Aiven CA secret file with Docker.
# SPRING_PROFILES_ACTIVE=prod,cloud
# DB_SSL_CA=/etc/secrets/aiven-ca.pem
# Create an administrator only for a fresh empty database, then disable/remove.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=CRM Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
